{
  "db_name": "PostgreSQL",
  "query": "SELECT\n    p.id,\n    p.title,\n    p.seo_title,\n    p.meta_description,\n    p.slug,\n    p.content,\n    p.status,\n    p.views,\n    p.published_at,\n    p.created_at,\n    p.updated_at\nFROM posts AS p\nINNER JOIN posts_tags AS pt ON pt.post_id = p.id\nINNER JOIN tags AS t ON t.id = pt.tag_id\nWHERE t.slug = $1\n    AND p.status = 'published'\nORDER BY p.published_at DESC NULLS LAST, p.created_at DESC;",
