[Unit]
Description=BuildHaven production container
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Service]
Environment=REGISTRY_AUTH_FILE=/root/.config/containers/auth.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=70
#ExecStartPre=/usr/bin/podman pull ghcr.io/vitor-curado/buildhaven:arm64
#ExecStartPre=/bin/sh -c 'until podman exec buildhaven-postgres pg_isready; do sleep 2; done'
ExecStart=/usr/bin/podman run \
        --env-file=/etc/buildhaven/.env \
        --network buildhaven-net \
        --cidfile=%t/%n.ctr-id \
        --cgroups=no-conmon \
        --sdnotify=conmon \
        --replace \
        --name buildhaven \
        -p 3000:3000 ghcr.io/vitor-curado/buildhaven:arm64
ExecStop=/usr/bin/podman stop \
        --ignore -t 10 \
        --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm \
        -f \
        --ignore -t 10 \
        --cidfile=%t/%n.ctr-id
Type=simple
NotifyAccess=all

[Install]
WantedBy=default.target