[Unit]
Description=BuildHaven Prometheus

[Container]
ContainerName=prometheus
Image=docker.io/prom/prometheus:v3.13.3
Network=buildhaven.network
Volume=/etc/BuildHaven/prometheus.yml:/etc/prometheus/prometheus.yml:ro
Exec=--config.file=/etc/prometheus/prometheus.yml
PublishPort=127.0.0.1:9090:9090

[Service]
Restart=always

[Install]
WantedBy=multi-user.target