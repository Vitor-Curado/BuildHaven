# Application
PORT=3000
MAX_REQUEST_BODY_SIZE=2097152

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://buildhaven:PLACEHOLDER@PLACEHOLDER:5432/buildhaven
TEST_DATABASE_URL=postgresql://buildhaven:PLACEHOLDER@localhost:5432/buildhaven_test
POSTGRES_USER=PLACEHOLDER
POSTGRES_PASSWORD=PLACEHOLDER
POSTGRES_DB=PLACEHOLDER

# Database connection pool
MIN_CONNECTIONS=1
MAX_CONNECTIONS=10
IDLE_TIMEOUT_SECS=300
ACQUIRE_TIMEOUT_SECS=30
MAX_LIFETIME_SECS=1800

# Caching (production)
#MAX_AGE_SECS=86400
#DURATION_HOURS=24
#CACHE_CONTROL="public, max-age=86400" 

# Caching (development)
MAX_AGE_SECS=0
DURATION_HOURS=24
CACHE_CONTROL=no-cache    

# Security
CONTENT_SECURITY_POLICY="default-src 'self'";
HSTS_ENABLED=false

# Grafana
GF_SECURITY_ADMIN_USER=PLACEHOLDER
GF_SECURITY_ADMIN_PASSWORD=PLACEHOLDER

# GitHub Personal Access Token
PAT=PLACEHOLDER